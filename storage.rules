rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function user() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function approved(workspaceId) { return request.auth != null && user().approvalStatus == 'approved' && user().workspaceId == workspaceId; }
    match /workspaces/{workspaceId}/{yearId}/{uid}/{allPaths=**} {
      allow read: if approved(workspaceId);
      allow create, update: if approved(workspaceId) && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|application/pdf|application/vnd.*|text/.*)');
      allow delete: if approved(workspaceId) && (request.auth.uid == uid || user().role == 'admin');
    }
  }
}
