rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function user() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function approved() { return signedIn() && user().approvalStatus == 'approved' && user().isDeleted != true; }
    function admin() { return approved() && user().role == 'admin'; }
    function sameWorkspace(data) { return approved() && data.workspaceId == user().workspaceId; }
    function immutableContext() { return request.resource.data.workspaceId == resource.data.workspaceId && request.resource.data.authorId == resource.data.authorId; }

    match /users/{uid} {
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.role == 'member'
        && request.resource.data.approvalStatus == 'pending';
      allow read: if signedIn() && (uid == request.auth.uid || admin());
      allow update: if admin() || (signedIn() && uid == request.auth.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.approvalStatus == resource.data.approvalStatus
        && request.resource.data.workspaceId == resource.data.workspaceId);
      allow delete: if false;
    }

    match /{collectionName}/{recordId} {
      allow read: if collectionName != 'users' && sameWorkspace(resource.data);
      allow create: if sameWorkspace(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.isDeleted == false
        && collectionName in ['meetings','lessonCases','reflections','lectures','purchaseRequests','resources','bookletEntries','comments','notifications'];
      allow create: if admin() && sameWorkspace(request.resource.data)
        && collectionName in ['years','workspaces','expenses','bookletProjects','announcements','activityLogs'];
      allow update: if sameWorkspace(resource.data) && immutableContext()
        && (resource.data.authorId == request.auth.uid || admin());
      allow delete: if false;
    }
  }
}
